# ============================================================
# GreenVest / RYMON Sovereign Environment Variables
# Copy to .env for local dev; never put server secrets in VITE_* vars.
# ============================================================

# Public Client Config (safe for Vite browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server / Render Daemon Secrets (DO NOT prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# OWNER_CHAT_ID=your-owner-telegram-chat-id
# RYMON_RELAY_SECRET=optional-random-shared-secret
# ALLOWED_ORIGIN=https://greenvest.shop
# SUPABASE_ACCESS_TOKEN=your-supabase-management-pat
