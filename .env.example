# Copy this file to `.env` for local development.
# GitHub Pages uses repository Secrets with the same names.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ── Super Admin Identity ──────────────────────────────────────────────────────
# These replace all hardcoded personal identifiers in the source code.
# Set them in .env (locally) and in GitHub Secrets (for CI/CD).
# Without these, shadow-admin mode is disabled and no local seed is created.
VITE_SUPER_ADMIN_EMAIL=your_admin_email@example.com
VITE_SUPER_ADMIN_PHONE=9876543210

# ── Support Contact (shown on contact/checkout pages) ─────────────────────────
# VITE_SUPPORT_PHONE=+91 9876543210
# VITE_SUPPORT_WHATSAPP=919876543210
# VITE_SUPPORT_EMAIL=greenvest.orders@gmail.com
# VITE_SUPPORT_HOURS=7:00 AM – 8:00 PM

# ── UPI Payment ───────────────────────────────────────────────────────────────
# VITE_UPI_ID=9876543210-2@ybl
# VITE_UPI_BANK=State Bank of India ····XXXX
# VITE_UPI_QR_SRC=/upi-qr.png
